{
  "expo": {
    "name": "TourCast",
    "slug": "tour-translation-app",
    "version": "1.5.5",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/85e52899-c6a8-4781-a57f-0ae1c38d380f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tourcast",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TourCast needs microphone access to capture and broadcast tour audio.",
        "NSCameraUsageDescription": "TourCast needs camera access to scan QR codes for joining sessions.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.danprav.tourcast",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TourCast needs camera access to scan QR codes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TourCast needs microphone access to capture and broadcast tour audio.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.1.20",
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            },
            "extraProguardRules": "-keep class com.danprav.tourcast.** { *; }",
            "enableShrinkResourcesInReleaseBuilds": false,
            "newArchEnabled": false,
            "reactNativeArchitectures": ["arm64-v8a"]
          }
        }
      ],
      "./plugins/withBackgroundActions.js",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85e52899-c6a8-4781-a57f-0ae1c38d380f"
      }
    },
    "owner": "danprav"
  }
}
